<Window x:Class="TateScribe.App.RubyBatchHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ruby batch history"
        Width="1120"
        Height="520"
        MinWidth="820"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Margin="0,0,0,10"
               TextWrapping="Wrap"
               Text="Select a saved ruby batch. Empty export batches are shown for context but cannot be opened." />

    <DataGrid x:Name="BatchGrid"
              Grid.Row="1"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              IsReadOnly="True"
              SelectionMode="Single"
              SelectionChanged="BatchSelectionChanged"
              MouseDoubleClick="OpenSelectedBatch">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Exported UTC"
                            Binding="{Binding ExportedUtc, StringFormat={}{0:u}}"
                            Width="145" />
        <DataGridTextColumn Header="Batch ID" Binding="{Binding BatchId}" Width="235" />
        <DataGridTextColumn Header="Document hash" Binding="{Binding DocumentTextHash}" Width="220" />
        <DataGridTextColumn Header="Policy" Binding="{Binding Policy}" Width="155" />
        <DataGridTextColumn Header="Annotations" Binding="{Binding AnnotationCount}" Width="80" />
        <DataGridTextColumn Header="Confirmed" Binding="{Binding ConfirmedCount}" Width="75" />
        <DataGridTextColumn Header="Proposed" Binding="{Binding ProposedCount}" Width="75" />
        <DataGridTextColumn Header="Stale" Binding="{Binding StaleCount}" Width="60" />
        <DataGridTextColumn Header="Unresolved" Binding="{Binding UnresolvedCount}" Width="75" />
        <DataGridTextColumn Header="Document" Binding="{Binding DocumentState}" Width="75" />
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="2"
                Margin="0,12,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button x:Name="OpenButton"
              Padding="14,7"
              Margin="0,0,8,0"
              Click="OpenSelectedBatch"
              IsDefault="True">Open selected batch</Button>
      <Button Padding="14,7" IsCancel="True">Cancel</Button>
    </StackPanel>
  </Grid>
</Window>
