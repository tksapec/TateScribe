<Window x:Class="TateScribe.App.ChatGptProofreadingPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatGPT最終校正用の指示"
        Width="760"
        Height="520"
        MinWidth="560"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Margin="0,0,0,10"
               TextWrapping="Wrap"
               Text="下の指示文を必要に応じて編集し、コピーして、校正対象のDOCXファイルと一緒にChatGPTへ貼り付けてください。" />

    <TextBox x:Name="PromptEditor"
             Grid.Row="1"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Disabled"
             FontSize="15"
             Padding="10" />

    <TextBlock x:Name="CopyStatus"
               Grid.Row="2"
               Margin="0,8,0,0"
               Foreground="DarkGreen"
               TextWrapping="Wrap" />

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button Padding="14,7"
              Margin="0,0,8,0"
              Click="CopyPrompt">クリップボードにコピー</Button>
      <Button Padding="14,7"
              Click="CloseWindow"
              IsCancel="True">閉じる</Button>
    </StackPanel>
  </Grid>
</Window>
