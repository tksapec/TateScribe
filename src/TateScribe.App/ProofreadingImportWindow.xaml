<Window x:Class="TateScribe.App.ProofreadingImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="校正結果の確認" Width="1100" Height="680" MinWidth="760" MinHeight="420">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,0,0,12" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
      <Button x:Name="SelectAllButton" Padding="10,4" Margin="0,0,6,0" Click="SelectAll">採用可能ページを全選択</Button>
      <Button x:Name="ClearAllButton" Padding="10,4" Margin="0,0,12,0" Click="ClearAll">全解除</Button>
      <Button x:Name="ShowMainPageButton" Padding="10,4" Margin="0,0,12,0" Click="ShowMainPage">選択ページをメイン画面で表示</Button>
      <CheckBox x:Name="WarningsOnly" VerticalAlignment="Center" Click="ToggleWarningsOnly">警告・エラーのあるページのみ表示</CheckBox>
    </StackPanel>
    <DataGrid x:Name="CandidateGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
              RowHeight="120" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="採用" Width="60">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsAccepted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding CanAccept}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="ページ" Binding="{Binding PageMarker}" Width="70" IsReadOnly="True" />
        <DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="150" IsReadOnly="True" />
        <DataGridTemplateColumn Header="取込み前" Width="220">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBox Text="{Binding BeforeText}" IsReadOnly="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" Background="#FFFFF4F4" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="取込み後" Width="220">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBox Text="{Binding AfterText}" IsReadOnly="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" Background="#FFF2FFF2" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="インライン差分" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding InlineSpans}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{Binding Background}" Padding="2,1" Margin="0,0,2,2"
                              ToolTip="{Binding ToolTip}">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="差分集計" Binding="{Binding DiffSummary}" Width="140" IsReadOnly="True" />
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Padding="12,6" Margin="0,0,8,0" Click="Cancel">キャンセル（保存しない）</Button>
      <Button Padding="12,6" IsDefault="True" Click="Accept">選択ページを保存</Button>
    </StackPanel>
  </Grid>
</Window>
