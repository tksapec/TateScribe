<Window x:Class="TateScribe.App.ProofreadingImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="校正結果の確認" Width="760" Height="520" MinWidth="640" MinHeight="360">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,0,0,12" />
    <DataGrid x:Name="CandidateGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="採用" Binding="{Binding IsAccepted}" Width="60" />
        <DataGridTextColumn Header="ページ" Binding="{Binding PageMarker}" Width="80" IsReadOnly="True" />
        <DataGridTextColumn Header="取込み本文" Binding="{Binding Preview}" Width="*" IsReadOnly="True" />
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Padding="12,6" Margin="0,0,8,0" Click="Cancel">保留</Button>
      <Button Padding="12,6" IsDefault="True" Click="Accept">選択ページを保存</Button>
    </StackPanel>
  </Grid>
</Window>
