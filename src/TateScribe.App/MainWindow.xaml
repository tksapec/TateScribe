<Window x:Class="TateScribe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TateScribe" Height="640" Width="1080" MinHeight="480" MinWidth="800">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="3*" />
        <RowDefinition Height="2*" MinHeight="90" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ScrollViewer x:Name="SidebarScrollViewer"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="0,0,6,0">
        <StackPanel>
          <Button Margin="0,0,0,8" Padding="12,6" Click="CreateProject">プロジェクトを作成／開く</Button>
          <Button Margin="0,0,0,12" Padding="12,6" Click="ImportImages">画像を追加</Button>
          <Button x:Name="RunOcrButton" Margin="0,0,0,8" Padding="12,6" Click="RunOcr">OCRを実行</Button>
          <Button x:Name="RunAllOcrButton" Margin="0,0,0,8" Padding="12,6" Click="RunAllOcr">全ページをOCR</Button>
          <Button x:Name="CancelOcrButton" Margin="0,0,0,12" Padding="12,6" Click="CancelOcr" IsEnabled="False">OCRを中止</Button>

          <GroupBox Header="ChatGPTとの受け渡し" Margin="0,0,0,10" Padding="6">
            <StackPanel>
              <Button Margin="0,0,0,6" Padding="8,5" Click="ShowChatGptProofreadingPrompt"
                      ToolTip="本文校正またはルビ確認の作業を選び、ChatGPTへ渡す指示文を表示・コピーします。">ChatGPTへの指示</Button>
              <Button Margin="0,0,0,6" Padding="8,5" Click="ExportProofreadingPackage"
                      ToolTip="OCR本文・原画像・取込み用マーカーをまとめた本文校正用パッケージを出力します。">本文校正用パッケージを出力</Button>
              <Button Margin="0,0,0,6" Padding="8,5" Click="ImportProofreadText"
                      ToolTip="ChatGPTが返したTateScribe formatVersion 2の構造化テキストを検証して取り込みます。">校正済みテキストを取り込む</Button>
              <ComboBox x:Name="RubyPolicySelector" Margin="0,2,0,6"
                        ToolTip="ルビ候補の範囲です。標準は原画像に実在するルビだけです。" />
              <Button Margin="0,0,0,6" Padding="8,5" Click="ExportRubyPackage"
                      ToolTip="確定本文、原画像、OCRルビ候補、JSON Schemaをフォルダーへ出力します。本文校正前は警告します。">ルビ確認用パッケージを出力</Button>
              <Button Padding="8,5" Click="ImportRubyJson"
                      ToolTip="ChatGPTが返したルビJSONを厳格に検証し、候補ごとの確認画面を開きます。エラー時はDBを変更しません。">ルビJSONを取り込んで確認</Button>
              <Button Margin="0,6,0,0" Padding="8,5" Click="ReviewSavedRuby"
                      ToolTip="直近に保存したルビ候補を再度開き、確定・却下・読み・範囲を見直します。">保存済みルビ候補を確認</Button>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="文書出力" Margin="0,0,0,10" Padding="6">
            <StackPanel>
              <CheckBox x:Name="PageBreakBeforeChapters" Margin="0,0,0,6"
                        ToolTip="例: ChapterTitleに設定した章見出しを、新しいページから開始します。通常のページ境界では改ページしません。">章タイトルの前で改ページ</CheckBox>
              <Button Margin="0,0,0,6" Padding="8,5" Click="ExportDocx"
                      ToolTip="確定本文と確認済みルビから、TateScribeが決定論的にDOCXを生成します。">DOCXへ出力</Button>
              <Button Padding="8,5" Click="ExportDenden"
                      ToolTip="book.md、ddconv.yml、CSS、READMEをZIP化せずフォルダーへ出力します。EPUBは生成しません。">でんでん用データを出力</Button>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="ページ設定" Margin="0,0,0,10" Padding="6">
            <StackPanel>
              <ComboBox x:Name="DisplayProfileSelector" Margin="0,0,0,4" ToolTip="通常本文は ReflowVertical、印刷ページ単位を保つ場合は FixedPageVertical を選びます。" />
              <ComboBox x:Name="PageRoleSelector" Margin="0,0,0,4" ToolTip="本文は Body、章見出しは ChapterTitle、挿絵は Illustration を選びます。" />
              <TextBox x:Name="PrintedPageNumberEditor" Margin="0,0,0,4" ToolTip="FixedPageVerticalで使う印刷ページ番号です。例: 42" />
              <Button Padding="8,4" Click="SavePageMetadata">ページ種別・表示形式を保存</Button>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="校正パッケージの範囲" Margin="0,0,0,10" Padding="6">
            <StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontSize="12" Text="開始" />
                <TextBox x:Name="ProofreadingStartPage" Width="38" Margin="4,0,0,0" Text="1" />
                <TextBlock VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0" Text="件数" />
                <TextBox x:Name="ProofreadingPageCount" Width="38" Margin="4,0,0,0" Text="10" />
              </StackPanel>
              <CheckBox x:Name="IncludeCroppedImages" Margin="0,5,0,0" IsChecked="True" HorizontalAlignment="Center">切り抜き確認画像を含める</CheckBox>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="画像の除外範囲（%）" Margin="0,0,0,10" Padding="6">
            <StackPanel>
              <Grid>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,4">
                  <TextBlock FontSize="12" Text="左" />
                  <TextBox x:Name="CropLeftPercent" MinWidth="64" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,4">
                  <TextBlock FontSize="12" Text="右" />
                  <TextBox x:Name="CropRightPercent" MinWidth="64" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                  <TextBlock FontSize="12" Text="上部" />
                  <TextBox x:Name="CropTopPercent" MinWidth="64" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
                  <TextBlock FontSize="12" Text="下部" />
                  <TextBox x:Name="CropBottomPercent" MinWidth="64" />
                </StackPanel>
              </Grid>
              <Button Margin="0,6,0,0" Padding="8,4" Click="ApplyCrop">切り抜きを適用</Button>
              <Button Margin="0,4,0,0" Padding="8,4" Click="ApplyCropToAll">全ページに適用</Button>
            </StackPanel>
          </GroupBox>

          <Button Margin="0,0,0,8" Padding="12,6" Click="TogglePageUsage">選択ページを使用／除外</Button>
        </StackPanel>
      </ScrollViewer>

      <ListBox x:Name="PageList" Grid.Row="1" Margin="0,8,6,0"
               DisplayMemberPath="DisplayLabel" SelectionChanged="PageSelectionChanged" />

      <StackPanel Grid.Row="2" Margin="0,8,6,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
          <Button Width="92" Padding="8,6" Margin="0,0,8,0" Click="RotatePageLeft">左へ90度</Button>
          <Button Width="92" Padding="8,6" Click="RotatePageRight">右へ90度</Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Width="76" Padding="8,6" Margin="0,0,8,0" Click="MovePageUp">上へ</Button>
          <Button Width="76" Padding="8,6" Click="MovePageDown">下へ</Button>
        </StackPanel>
      </StackPanel>
    </Grid>
    <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="24">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="28">TateScribe</TextBlock>
        <StackPanel Grid.Row="1" Margin="0,12,0,12">
          <TextBlock TextWrapping="Wrap">OCR根拠を保持した本文編集。低信頼度文字は確定せず、確認後に保存してください。</TextBlock>
          <TextBlock x:Name="TextSourceStatus" Margin="0,6,0,0" Foreground="SlateGray" TextWrapping="Wrap" />
          <TextBlock x:Name="ReviewStatus" Margin="0,6,0,0" Foreground="DarkOrange" />
        </StackPanel>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border BorderBrush="LightGray" BorderThickness="1" Padding="4">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                <Button Padding="8,3" Click="ZoomOut">縮小</Button>
                <Button Padding="8,3" Margin="4,0" Click="ZoomActual">100%</Button>
                <Button Padding="8,3" Click="ZoomIn">拡大</Button>
              </StackPanel>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                  <Image x:Name="PagePreview" Stretch="Fill" SizeChanged="PreviewSizeChanged" />
                  <Canvas x:Name="CropOverlay" IsHitTestVisible="False">
                    <Border x:Name="TopCropOverlay" Background="#66000000" HorizontalAlignment="Stretch" />
                    <Border x:Name="BottomCropOverlay" Background="#66000000" HorizontalAlignment="Stretch" Canvas.Bottom="0" />
                    <Border x:Name="LeftCropOverlay" Background="#66000000" VerticalAlignment="Stretch" />
                    <Border x:Name="RightCropOverlay" Background="#66000000" VerticalAlignment="Stretch" Canvas.Right="0" />
                    <TextBlock x:Name="TopCropLabel" Foreground="White" Margin="6,4" />
                    <TextBlock x:Name="BottomCropLabel" Foreground="White" Canvas.Bottom="4" Margin="6,0" />
                    <TextBlock x:Name="LeftCropLabel" Foreground="White" Margin="6,24" />
                    <TextBlock x:Name="RightCropLabel" Foreground="White" Canvas.Right="4" Margin="0,24" />
                  </Canvas>
                </Grid>
              </ScrollViewer>
            </DockPanel>
          </Border>
          <TextBox x:Name="TextEditor" Grid.Column="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="16" />
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button x:Name="PageReviewButton" Margin="0,0,8,0" Padding="12,6" Click="ShowPageReview"
                  ToolTip="選択ページのManual/Confirmed履歴を復元し、ルビ候補の分類と下書きへの採否を変更します。">本文履歴・ルビ候補</Button>
          <Button Padding="12,6" Click="SaveManualText">手動修正を保存</Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
