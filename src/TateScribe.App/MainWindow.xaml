<Window x:Class="TateScribe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TateScribe" Height="640" Width="1080" MinHeight="480" MinWidth="800">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0">
      <Button DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12,6" Click="ImportImages">画像を追加</Button>
      <ListBox x:Name="PageList" DisplayMemberPath="Name" />
    </DockPanel>
    <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="24">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock FontSize="28" HorizontalAlignment="Center">TateScribe</TextBlock>
        <TextBlock Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap">縦書き電子書籍スクリーンショットを取り込み、OCR証跡を保持したまま編集可能なDOCXへ出力します。OCRモデルはローカルのワーカー設定後に実行できます。</TextBlock>
      </StackPanel>
    </Border>
  </Grid>
</Window>
