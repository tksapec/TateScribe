<Window x:Class="TateScribe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TateScribe" Height="640" Width="1080" MinHeight="480" MinWidth="800">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0">
      <Button DockPanel.Dock="Top" Margin="0,0,0,8" Padding="12,6" Click="CreateProject">プロジェクトを作成／開く</Button>
      <Button DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12,6" Click="ImportImages">画像を追加</Button>
      <Button x:Name="RunOcrButton" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="12,6" Click="RunOcr">OCRを実行</Button>
      <Button x:Name="RunAllOcrButton" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="12,6" Click="RunAllOcr">全ページをOCR</Button>
      <Button x:Name="CancelOcrButton" DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12,6" Click="CancelOcr" IsEnabled="False">OCRを中止</Button>
      <Button DockPanel.Dock="Top" Margin="0,0,0,8" Padding="12,6" Click="ExportProofreadingPackage">校正用パッケージを出力</Button>
      <Button DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12,6" Click="ImportProofreadText">校正済みテキストを取り込む</Button>
      <Button DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12,6" Click="ExportDocx">DOCXへ出力</Button>
      <Button DockPanel.Dock="Top"
              Margin="0,0,0,12"
              Padding="12,6"
              Click="ShowChatGptProofreadingPrompt"
              ToolTip="ChatGPTへDOCXの最終校正を依頼するための、編集・コピー可能な指示文を表示します。">ChatGPT最終校正用の指示</Button>
      <CheckBox x:Name="PageBreakBeforeChapters" DockPanel.Dock="Top" Margin="0,0,0,8" ToolTip="DOCX出力時の例: ページ種別を ChapterTitle にしたページを、新しいページから始めます。">章タイトルの前で改ページ</CheckBox>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
        <Button Width="76" Padding="8,6" Margin="0,0,8,0" Click="MovePageUp">上へ</Button>
        <Button Width="76" Padding="8,6" Click="MovePageDown">下へ</Button>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
        <Button Width="92" Padding="8,6" Margin="0,0,8,0" Click="RotatePageLeft">左へ90度</Button>
        <Button Width="92" Padding="8,6" Click="RotatePageRight">右へ90度</Button>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
        <Grid HorizontalAlignment="Center">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,3">
            <TextBlock VerticalAlignment="Center" FontSize="12" Text="左除外%" />
            <TextBox x:Name="CropLeftPercent" Width="42" Margin="3,0,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
            <TextBlock VerticalAlignment="Center" FontSize="12" Text="右除外%" />
            <TextBox x:Name="CropRightPercent" Width="42" Margin="3,0,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
            <TextBlock VerticalAlignment="Center" FontSize="12" Text="上部除外%" />
            <TextBox x:Name="CropTopPercent" Width="42" Margin="3,0,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" FontSize="12" Text="下部除外%" />
            <TextBox x:Name="CropBottomPercent" Width="42" Margin="3,0,0,0" />
          </StackPanel>
        </Grid>
        <Button Width="144" HorizontalAlignment="Center" Margin="0,6,0,0" Padding="8,4" Click="ApplyCrop">切り抜きを適用</Button>
        <Button Width="144" HorizontalAlignment="Center" Margin="0,4,0,0" Padding="8,4" Click="ApplyCropToAll">全ページに適用</Button>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
        <ComboBox x:Name="DisplayProfileSelector" Margin="0,0,0,4" ToolTip="表示形式です。例: 通常の本文は ReflowVertical、印刷ページ単位を扱う場合は FixedPageVertical を選びます。" />
        <ComboBox x:Name="PageRoleSelector" Margin="0,0,0,4" ToolTip="ページ種別です。例: 本文は Body、章見出しだけのページは ChapterTitle、挿絵は Illustration を選びます。IllustrationとBlankは除外し、Otherは本文があれば確認後に含めます。" />
        <TextBox x:Name="PrintedPageNumberEditor" Margin="0,0,0,4" ToolTip="印刷ページ番号です。FixedPageVertical を選んだページで、例: 42 のように入力します。" />
        <Button Padding="8,4" Click="SavePageMetadata" ToolTip="選択した表示形式・ページ種別・印刷ページ番号を、現在選んでいるページへ保存します。">ページ種別・表示形式を保存</Button>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock VerticalAlignment="Center" FontSize="12" Text="校正範囲 開始" />
          <TextBox x:Name="ProofreadingStartPage" Width="34" Margin="3,0,0,0" Text="1" />
          <TextBlock VerticalAlignment="Center" FontSize="12" Margin="6,0,0,0" Text="件数" />
          <TextBox x:Name="ProofreadingPageCount" Width="34" Margin="3,0,0,0" Text="10" />
        </StackPanel>
        <CheckBox x:Name="IncludeCroppedImages" Margin="0,4,0,0" IsChecked="True" HorizontalAlignment="Center">切り抜き確認画像を含める</CheckBox>
      </StackPanel>
      <Button DockPanel.Dock="Bottom" Margin="0,0,0,8" Padding="12,6" Click="TogglePageUsage">使用／除外</Button>
      <ListBox x:Name="PageList" DisplayMemberPath="DisplayLabel" SelectionChanged="PageSelectionChanged" />
    </DockPanel>
    <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="24">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="28">TateScribe</TextBlock>
        <StackPanel Grid.Row="1" Margin="0,12,0,12">
          <TextBlock TextWrapping="Wrap">OCR根拠を保持した本文編集。低信頼度文字は確定せず、確認後に保存してください。</TextBlock>
          <TextBlock x:Name="TextSourceStatus" Margin="0,6,0,0" Foreground="SlateGray" TextWrapping="Wrap" />
          <TextBlock x:Name="ReviewStatus" Margin="0,6,0,0" Foreground="DarkOrange" />
        </StackPanel>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border BorderBrush="LightGray" BorderThickness="1" Padding="4">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                <Button Padding="8,3" Click="ZoomOut">縮小</Button>
                <Button Padding="8,3" Margin="4,0" Click="ZoomActual">100%</Button>
                <Button Padding="8,3" Click="ZoomIn">拡大</Button>
              </StackPanel>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                  <Image x:Name="PagePreview" Stretch="Fill" SizeChanged="PreviewSizeChanged" />
                  <Canvas x:Name="CropOverlay" IsHitTestVisible="False">
                    <Border x:Name="TopCropOverlay" Background="#66000000" HorizontalAlignment="Stretch" />
                    <Border x:Name="BottomCropOverlay" Background="#66000000" HorizontalAlignment="Stretch" Canvas.Bottom="0" />
                    <Border x:Name="LeftCropOverlay" Background="#66000000" VerticalAlignment="Stretch" />
                    <Border x:Name="RightCropOverlay" Background="#66000000" VerticalAlignment="Stretch" Canvas.Right="0" />
                    <TextBlock x:Name="TopCropLabel" Foreground="White" Margin="6,4" />
                    <TextBlock x:Name="BottomCropLabel" Foreground="White" Canvas.Bottom="4" Margin="6,0" />
                    <TextBlock x:Name="LeftCropLabel" Foreground="White" Margin="6,24" />
                    <TextBlock x:Name="RightCropLabel" Foreground="White" Canvas.Right="4" Margin="0,24" />
                  </Canvas>
                </Grid>
              </ScrollViewer>
            </DockPanel>
          </Border>
          <TextBox x:Name="TextEditor" Grid.Column="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="16" />
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button x:Name="PageReviewButton" Margin="0,0,8,0" Padding="12,6" Click="ShowPageReview"
                  ToolTip="選択ページのManual/Confirmed履歴を復元し、ルビ候補の分類と下書きへの採否を変更します。">本文履歴・ルビ候補</Button>
          <Button Padding="12,6" Click="SaveManualText">手動修正を保存</Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
